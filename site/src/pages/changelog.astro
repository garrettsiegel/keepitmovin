---
import { readFile } from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

// CHANGELOG.md lives at the repo root, one level above this Astro project.
//
// This used to resolve `../../../CHANGELOG.md` from `import.meta.url`, which
// assumed the page stays where its source file is. Astro 7 bundles prerendered
// pages into `dist/.prerender/chunks/`, so that relative walk landed on
// `site/CHANGELOG.md` and the build died with ENOENT. Resolve from the project
// root instead — that is stable regardless of where the page gets bundled.
const candidates = [
  path.resolve(process.cwd(), "../CHANGELOG.md"), // build run from site/
  path.resolve(process.cwd(), "CHANGELOG.md") // build run from the repo root
];

const readChangelog = async (): Promise<string> => {
  for (const candidate of candidates) {
    try {
      return await readFile(candidate, "utf8");
    } catch {
      // Try the next candidate.
    }
  }

  throw new Error(
    `changelog.astro could not find CHANGELOG.md. Looked in:\n  ${candidates.join("\n  ")}`
  );
};

const source = await readChangelog();
const escape = (value: string): string => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;");
const inline = (value: string): string => escape(value)
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/`(.+?)`/g, "<code>$1</code>");
const lines = source.split("\n").slice(1);
const html = lines.map((line) => {
  if (line.startsWith("## ")) return `<h2>${inline(line.slice(3))}</h2>`;
  if (line.startsWith("### ")) return `<h3>${inline(line.slice(4))}</h3>`;
  if (line.startsWith("- ")) return `<p class="changelog-item">• ${inline(line.slice(2))}</p>`;
  return line.trim() ? `<p>${inline(line)}</p>` : "";
}).join("\n");
---

<BaseLayout title="Changelog — keepitmovin" description="Every shipped keepitmovin release and notable change.">
  <article class="docs-content prose standalone-prose container">
    <p class="eyebrow">Releases</p>
    <h1>Changelog</h1>
    <div set:html={html} />
  </article>
</BaseLayout>
