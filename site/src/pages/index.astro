---
import BaseLayout from "../layouts/BaseLayout.astro";
import HandoffMeter from "../components/HandoffMeter.astro";
import HeroFlow from "../components/HeroFlow.astro";
import InstallCommand from "../components/InstallCommand.astro";
import SupportedToolsTicker from "../components/SupportedToolsTicker.astro";
import { comparisonRows, handoffSteps } from "../lib/landing-data";
import { iconBox, supportedTools } from "../lib/supported-tools";

const title = "keepitmovin — Agents hit limits. Your work doesn't.";
const description =
  "When one coding agent hits its limit, the next one picks up where it left off. Open source, local, zero config.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <HeroFlow />
    <div class="container">
      <p class="hero-badge">Open source · MIT · one terminal</p>
      <h1>Agents hit limits. Your work doesn't.</h1>
      <p class="subline">
        When one coding agent hits its limit, the next one picks up where it
        left off.
      </p>
      <div class="hero-actions">
        <InstallCommand command="npm install -g keepitmovin" />
      </div>
      <p class="hero-note">
        Then run <code>movin</code>. It finds your tools; you pick the order.
      </p>
      <HandoffMeter />
    </div>
  </section>

  <SupportedToolsTicker />

  <!-- The handoff -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Limit hit. Next tool. Keep typing.</h2>
      </div>
      <ol class="steps">
        {
          handoffSteps.map((step) => (
            <li>
              <span class="step-label">{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The difference</p>
        <h2>One long session, not five short ones.</h2>
        <p class="lede">
          You already pay for these tools. keepitmovin chains their limits
          into one continuous session.
        </p>
      </div>
      <div class="vs">
        <div class="vs-panel kim">
          <h3>With keepitmovin</h3>
          <ul>
            {
              comparisonRows.map((row) => (
                <li>
                  <strong>{row.label}</strong>
                  {row.kim}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="vs-panel raw">
          <h3>Running agents raw</h3>
          <ul>
            {
              comparisonRows.map((row) => (
                <li>
                  <strong>{row.label}</strong>
                  {row.raw}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools wall -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Supported tools</p>
        <h2>Works with the tools you already use.</h2>
        <p class="lede">
          Thirteen tools today. Ollama runs last, locally, for when every cloud
          tool is blocked.
        </p>
      </div>
      <div class="tools-grid">
        {
          supportedTools.map((tool) => (
            <a class="tool" href={tool.url} target="_blank" rel="noopener">
              <span class="tool-name">
                {tool.icon ? (
                  <svg viewBox={iconBox(tool, 18).viewBox} aria-hidden="true" width={iconBox(tool, 18).width} height="18" fill="currentColor">
                    <path d={tool.icon} fill-rule={tool.iconEvenOdd ? "evenodd" : undefined} />
                  </svg>
                ) : (
                  <span class="ticker-mono">{tool.mono}</span>
                )}
                {tool.name}
                {tool.tag && <span class="tool-tag">{tool.tag}</span>}
              </span>
              <code class="tool-cmd">{tool.cmd}</code>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="section" id="trust">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Local by design</p>
        <h2>Your work stays in your project.</h2>
        <p class="lede">
          keepitmovin uploads nothing. Your tools still talk to their own
          providers, as they always did.
        </p>
      </div>
      <div class="trust-grid">
        <article class="trust-card">
          <h3>Local files</h3>
          <p>Handoffs and logs live in <code>.keepitmovin/</code>, gitignored automatically.</p>
        </article>
        <article class="trust-card">
          <h3>No extra model calls</h3>
          <p>The tool you're already running keeps the handoff up to date.</p>
        </article>
        <article class="trust-card">
          <h3>Secrets redacted</h3>
          <p>Common credential formats are stripped before anything is written.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container narrow-section">
      <div class="section-head">
        <p class="eyebrow">Before you ask</p>
        <h2>Questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Does the next tool get my chat history?</summary>
          <p>No — no agent can transfer that today. It starts fresh with the handoff: your goal, decisions, recent changes, and next step.</p>
        </details>
        <details class="faq-item">
          <summary>Won't the handoff go stale?</summary>
          <p>No. The working agent updates it after each subtask, and keepitmovin refreshes repo state as you go.</p>
        </details>
        <details class="faq-item">
          <summary>Can I switch before a limit is hit?</summary>
          <p>Yes. Press <kbd>Ctrl+]</kbd> anytime.</p>
        </details>
        <details class="faq-item">
          <summary>Does it commit or push code?</summary>
          <p>Never. It watches, records, and switches.</p>
        </details>
      </div>
      <p class="section-link"><a href="/docs/faq">Read the full FAQ →</a></p>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <h2>Keep it movin'.</h2>
      </div>
      <div class="hero-actions">
        <InstallCommand command="npm install -g keepitmovin" />
      </div>
    </div>
  </section>
</BaseLayout>
