---
import BaseLayout from "../layouts/BaseLayout.astro";
import HandoffMeter from "../components/HandoffMeter.astro";
import HeroFlow from "../components/HeroFlow.astro";
import InstallCommand from "../components/InstallCommand.astro";
import SupportedToolsTicker from "../components/SupportedToolsTicker.astro";
import { comparisonRows, handoffSteps } from "../lib/landing-data";
import { iconBox, supportedTools } from "../lib/supported-tools";

const title = "keepitmovin — Agents hit limits. Your work doesn't.";
const description =
  "keepitmovin runs your coding agents in one terminal, watches for rate limits, and hands the next tool a structured record of the work.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <HeroFlow />
    <div class="container">
      <p class="hero-badge">Open source · MIT · one terminal</p>
      <h1>Agents hit limits. Your work doesn't.</h1>
      <p class="subline">
        keepitmovin runs your coding agents in one terminal, watches for rate
        limits, and hands the next tool a structured record of the goal,
        changes, blockers, and next step.
      </p>
      <div class="hero-actions">
        <InstallCommand command="npm install -g keepitmovin" />
      </div>
      <p class="hero-note">
        Then run <code>movin</code>. A first-run wizard detects your installed
        tools and you pick a fallback order. Zero config to start.
      </p>
      <HandoffMeter />
    </div>
  </section>

  <!-- Trust -->
  <section class="section" id="trust">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Local by design</p>
        <h2>Your continuity stays with your project.</h2>
        <p class="lede">
          keepitmovin does not upload handoffs or session logs. Your coding
          tools still connect to their own providers under their own terms.
        </p>
      </div>
      <div class="trust-grid">
        <article class="trust-card">
          <h3>Local session data</h3>
          <p>Handoffs and summaries live under <code>.keepitmovin/</code>, which gets its own gitignore.</p>
        </article>
        <article class="trust-card">
          <h3>No extra model call by default</h3>
          <p>The active tool maintains the handoff during normal work. Opt-in Jev routing sends only sanitized task text to TypeSafe.</p>
        </article>
        <article class="trust-card">
          <h3>Defensive redaction</h3>
          <p>Common credential formats are redacted before persistence. Treat local artifacts as sensitive anyway.</p>
        </article>
        <article class="trust-card">
          <h3>Open source</h3>
          <p>The CLI is MIT licensed. Read the code, audit the behavior, and keep using it for free.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container narrow-section">
      <div class="section-head">
        <p class="eyebrow">Before you ask</p>
        <h2>Practical continuity, not a cloned chat.</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Does it transfer the private chat session?</summary>
          <p>No. The next tool starts fresh and reads a live handoff containing the goal, decisions, changes, checks, blockers, and next action.</p>
        </details>
        <details class="faq-item">
          <summary>Is the handoff just another stale context file?</summary>
          <p>No. The working agent is prompted to revise it after each subtask, while keepitmovin refreshes repository state and recent changes during the session.</p>
        </details>
        <details class="faq-item">
          <summary>Does keepitmovin send my data anywhere?</summary>
          <p>keepitmovin itself does not upload handoffs or logs. The agents it launches still communicate with their own providers.</p>
        </details>
        <details class="faq-item">
          <summary>Can I switch before a limit is hit?</summary>
          <p>Yes. Press <kbd>Ctrl+]</kbd> to pack the current context and move to the next tool whenever you choose.</p>
        </details>
        <details class="faq-item">
          <summary>Does it commit or push code?</summary>
          <p>Never. keepitmovin watches, records local continuity, and switches tools. The launched tools retain their own permissions and behavior.</p>
        </details>
      </div>
      <p class="section-link"><a href="/docs/faq">Read the full FAQ →</a></p>
    </div>
  </section>

  <SupportedToolsTicker />

  <!-- The handoff -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The handoff</p>
        <h2>The handoff is automatic.</h2>
        <p class="lede">
          When a tool hits its usage limit, keepitmovin detects the exact
          limit message and starts your next tool. No copy-pasting context,
          no lost thread, no "where was I".
        </p>
      </div>
      <ol class="steps">
        {
          handoffSteps.map((step) => (
            <li>
              <span class="step-label">{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="aside">
        Switch on your own schedule: press <kbd>Ctrl+]</kbd> to hand off to
        the next tool anytime. Everything keepitmovin writes lives in
        <code>.keepitmovin/</code> in your project.
      </p>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The difference</p>
        <h2>One long session, not five short ones.</h2>
        <p class="lede">
          You already pay for these tools. keepitmovin chains their limits
          into one continuous working session.
        </p>
      </div>
      <div class="vs">
        <div class="vs-panel kim">
          <h3>With keepitmovin</h3>
          <ul>
            {
              comparisonRows.map((row) => (
                <li>
                  <strong>{row.label}</strong>
                  {row.kim}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="vs-panel raw">
          <h3>Running agents raw</h3>
          <ul>
            {
              comparisonRows.map((row) => (
                <li>
                  <strong>{row.label}</strong>
                  {row.raw}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools wall -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Supported tools</p>
        <h2>Works with the tools you already use.</h2>
        <p class="lede">
          Thirteen tools supported today. keepitmovin detects what's installed;
          you pick the fallback order. Ollama sits last — a local fallback
          for advice and planning when every cloud tool is blocked.
        </p>
      </div>
      <div class="tools-grid">
        {
          supportedTools.map((tool) => (
            <a class="tool" href={tool.url} target="_blank" rel="noopener">
              <span class="tool-name">
                {tool.icon ? (
                  <svg viewBox={iconBox(tool, 18).viewBox} aria-hidden="true" width={iconBox(tool, 18).width} height="18" fill="currentColor">
                    <path d={tool.icon} fill-rule={tool.iconEvenOdd ? "evenodd" : undefined} />
                  </svg>
                ) : (
                  <span class="ticker-mono">{tool.mono}</span>
                )}
                {tool.name}
                {tool.tag && <span class="tool-tag">{tool.tag}</span>}
              </span>
              <code class="tool-cmd">{tool.cmd}</code>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Honest limitation -->
  <section class="section">
    <div class="container">
      <div class="pull">
        <p class="eyebrow">The trade, stated plainly</p>
        <p>When keepitmovin switches tools, the new tool starts a fresh session.</p>
        <p class="pull-sub">
          It gets the handoff file — your goal, decisions, and recent
          changes — not the previous tool's private chat history. No coding
          agent can transfer that today. That's the trade, stated plainly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
