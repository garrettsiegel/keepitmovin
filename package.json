{
  "name": "keepitmovin",
  "version": "4.1.0",
  "description": "Run your AI coding tools (Claude Code, Codex, Kimi CLI, Google Antigravity, opencode, Pi, Grok Build, Cursor Agent, GitHub Copilot CLI, Factory Droid, Amp, Qwen Code, Ollama) in one terminal. When one hits its usage limit, keepitmovin hands the next tool a handoff file with your full context — so you never stop mid-task.",
  "keywords": [
    "cli",
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "kimi",
    "moonshot",
    "antigravity",
    "opencode",
    "grok",
    "grok-build",
    "xai",
    "cursor",
    "cursor-agent",
    "github-copilot",
    "ollama",
    "keepitmovin",
    "rate-limit",
    "handoff",
    "terminal",
    "pty"
  ],
  "homepage": "https://github.com/garrettsiegel/keepitmovin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garrettsiegel/keepitmovin.git"
  },
  "license": "MIT",
  "author": "Garrett Siegel",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "overrides": {
      "fast-uri": ">=4.1.4",
      "ip-address": ">=10.3.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "keepitmovin": "dist/cli.js",
    "movin": "dist/cli.js",
    "kim": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm clean && tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "release": "bash scripts/release.sh",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "execa": "^10.0.0",
    "node-pty": "^1.1.0",
    "ora": "^9.0.0",
    "strip-ansi": "^7.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2"
  }
}
